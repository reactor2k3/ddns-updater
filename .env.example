# Copy to .env and replace this EXAMPLE with your Docker host's private LAN IP.
WEB_HOST=192.168.1.100
WEB_PORT=8095

# Optional: exact browser-facing HTTPS address provided by your reverse proxy.
# Passkeys require a trusted certificate and a suitable hostname.
# AUTH_ORIGIN=https://ddns.example.com

# Optional: require HTTPS outside localhost instead of permitting LAN HTTP.
# AUTH_ALLOW_INSECURE_HTTP=false
